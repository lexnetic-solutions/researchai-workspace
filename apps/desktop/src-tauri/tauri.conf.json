{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchAI Workspace",
  "version": "0.1.5",
  "identifier": "app.researchai.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ResearchAI Workspace",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/exports/*",
          "$APPDATA/transcribe/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "resources": {
      "packaging/resources/sidecar/": "sidecar/",
      "packaging/resources/llama/": "llama/",
      "packaging/resources/models/": "models/",
      "../../../services/voice-engine/": "voice-engine/"
    },
    "shortDescription": "Offline-first AI research workspace",
    "longDescription": "Private, offline-first research intelligence: import papers, search and ask with citations, build evidence matrices, export academic artefacts, transcribe lectures and listen to spoken summaries \u2014 all on your machine.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNEE3OEU1MTA3MDQ4OTMKUldTVFNIQVE1WGhLTzUyK3Q0ZE5qaklNYUx0cE5rMkpHS0UzaEtsOFZ4azZrQk02K1ZqdzRMMzMK",
      "endpoints": [
        "https://github.com/lexnetic-solutions/researchai-workspace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
