# Node
node_modules/
dist/
coverage/
*.log

# Generated dev-only preview artefact
apps/desktop/preview.html

# Rust / Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Local application data (never commit research data)
ResearchAIData/
*.db
*.db-wal
*.db-shm

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Model artefacts are downloaded, never committed
data/models/*
!data/models/README.md
data/cache/*
!data/cache/README.md

# Environment & OS
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Phase 9 generated artefacts (rebuild with tauri icon / collect-sidecar)
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/
# collect-sidecar output: frozen engine binary + PyInstaller _internal/
# runtime (138 MB — never commit; rebuilt by CI and collect-sidecar.mjs)
apps/desktop/src-tauri/packaging/resources/sidecar/researchai-engine
apps/desktop/src-tauri/packaging/resources/sidecar/researchai-engine.exe
apps/desktop/src-tauri/packaging/resources/sidecar/_internal/
# Bundled AI assets from fetch-ai-assets.mjs / seed_embeddings.py
# (llama-server binary, ~397 MB GGUF, ~90 MB embedding model). The
# directories themselves are tracked via .gitkeep — Tauri's build script
# hard-fails when a declared resource path doesn't exist.
apps/desktop/src-tauri/packaging/resources/llama/*
!apps/desktop/src-tauri/packaging/resources/llama/.gitkeep
apps/desktop/src-tauri/packaging/resources/models/*
!apps/desktop/src-tauri/packaging/resources/models/.gitkeep
# PyInstaller work directory
services/document-engine/build/

# Local release artifacts staged for transfer (never commit)
delivery/
